{
  "name": "base-arm-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-runtime.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx watch examples/nodejs-api/src/index.ts",
    "dev:supervisor": "tsx examples/supervisor/src/index.ts",
    "dev:registration": "tsx examples/supervisor/src/registration.ts",
    "deploy:zip": "tsx examples/supervisor/src/install-package.ts",
    "app:manage": "tsx examples/supervisor/src/manage-app.ts",
    "dev:management": "tsx examples/supervisor/src/management-api.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify": "npm run build && npm run check:architecture && npm test",
    "build:exe": "npm run build && node scripts/build-sea.mjs",
    "package:windows": "npm run build:exe && node scripts/package-windows.mjs",
    "package:windows:reuse-exe": "node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  }
}
