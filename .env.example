# Copy to .env at repository root, then set real secrets. Never commit .env.
# Existing shell/container environment variables override values from this file.

# Management API (token required, at least 16 characters)
ARM_MANAGEMENT_TOKEN=
ARM_DEPLOYMENT_ROOT=./supervisor-data
ARM_MANAGEMENT_PORT=3300

# Runtime monitoring and Phase 6 rollout (milliseconds)
ARM_MONITOR_INTERVAL_MS=1000
ARM_STABLE_RESET_MS=60000
ARM_ROLLOUT_STABILITY_MS=1500

# Phase 7 Blue/Green (empty APP_ID disables this feature)
ARM_BLUE_GREEN_APP_ID=
ARM_PROXY_PORT=3400
ARM_BLUE_PORT=3401
ARM_GREEN_PORT=3402

# Phase 8 automatic instrumentation
ARM_AUTO_INJECT=0
ARM_TELEMETRY_INTERVAL_MS=1000

# Phase 9 Client Runtime Bridge (empty APP_ID disables this feature)
ARM_CLIENT_BRIDGE_APP_ID=
ARM_BRIDGE_REGISTRATION_PORT=3200
ARM_BRIDGE_METRICS_BASE_PORT=3500
# Must be different secrets of at least 16 characters if bridge is enabled.
ARM_BRIDGE_REGISTRATION_TOKEN=
ARM_BRIDGE_METRICS_TOKEN=

# Legacy/embedded ARM Client SDK
ARM_METRICS_TOKEN=

# Standalone registration demo (npm run dev:registration)
SUPERVISOR_REGISTRATION_TOKEN=
SUPERVISOR_PORT=3200

# Standalone Node example (npm run dev)
PORT=3100
APPLICATION_ID=example-app
INSTANCE_ID=example-app-local
SUPERVISOR_URL=http://127.0.0.1:3200

# Runtime-generated values are NOT configured here:
# ARM_APPLICATION_ID, ARM_INSTANCE_ID, ARM_INJECTION_ENABLED,
# ARM_TELEMETRY_ROOT, ARM_SAMPLE_INTERVAL_MS, ARM_BRIDGE_ENABLED,
# ARM_BRIDGE_METRICS_PORT, ARM_BRIDGE_MODULE_PATH,
# ARM_BRIDGE_REGISTRATION_URL, NODE_ENV, HOST
